/dts-v1/;
/plugin/;

#include <dt-bindings/clock/rockchip,rk3576-cru.h>
#include <dt-bindings/power/rk3576-power.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>

/ {
	fragment@0 {
		target-path = "/";
		__overlay__ {
			vcc_cam0_pwdn: vcc-cam0-pwdn {
				compatible = "regulator-fixed";
				regulator-name = "vcc_cam0_pwdn";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
				regulator-boot-on;
				regulator-always-on;
				enable-active-high;
				vin-supply = <&vcc_1v8_s3>;
				gpio = <&gpio3 RK_PA1 GPIO_ACTIVE_HIGH>;
			};
		};
	};
	
	fragment@1 {
		target = <&i2c2>;
		__overlay__ {
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <&i2c2m0_xfer>;
			#address-cells = <1>;
			#size-cells = <0>;

			camera0_imx219: camera0-imx219@10 {
				status = "okay";
				compatible = "sony,imx219";
				reg = <0x10>;
				clocks = <&cru CLK_MIPI_CAMERAOUT_M0>;
				clock-names = "xvclk";
				pinctrl-names = "rockchip,camera_default";
				pinctrl-0 = <&cam_clk0m1_clk0>;//
				avdd-supply = <&vcc_cam0_pwdn>;
				rockchip,camera-module-index = <0>;
				rockchip,camera-module-facing = "back";
				rockchip,camera-module-name = "rpi-camera-v2";
				rockchip,camera-module-lens-name = "default";
				port {
					imx219_out0: endpoint {
						remote-endpoint = <&mipidphy1_in_ucam0>;
						data-lanes = <1 2>;
						clock-noncontinuous;
						link-frequencies = /bits/ 64 <456000000>;
					};
				};
			};
		};
	};
	
	fragment@2 {
		target = <&csi2_dphy0_hw>;

		__overlay__ {
			status = "okay";
		};
	};
	
	fragment@3 {
		target = <&csi2_dphy1_hw>;

		__overlay__ {
			status = "okay";
		};
	};

/* 1. camera0_imx219 (i2c2) -> csi2_dphy1 -> mipi1_csi2 -> rkcif_mipi_lvds1 -> isp_vir0 (video0)*/
	fragment@4 {
		target = <&csi2_dphy1>;

		__overlay__ {
			status = "okay";
			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;

					mipidphy1_in_ucam0: endpoint@1 {
						reg = <1>;
						remote-endpoint = <&imx219_out0>;
						data-lanes = <1 2>;
					};
				};

				port@1 {
					reg = <1>;
					#address-cells = <1>;
					#size-cells = <0>;

					csidphy1_out: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&mipi1_csi2_input>;
					};
				};
			};
		};
	};
	
	fragment@5 {
		target = <&mipi1_csi2>;

		__overlay__ {
			status = "okay";
			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;

					mipi1_csi2_input: endpoint@1 {
						reg = <1>;
						remote-endpoint = <&csidphy1_out>;
					};
				};

				port@1 {
					reg = <1>;
					#address-cells = <1>;
					#size-cells = <0>;

					mipi1_csi2_output: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&cif_mipi_in1>;
					};
				};
			};
		};
	};
	
	fragment@6 {
		target = <&rkcif>;

		__overlay__ {
			status = "okay";
		};
	};
	
	fragment@7 {
		target = <&rkcif_mmu>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@8 {
		target = <&rkisp>;

		__overlay__ {
			status = "okay";
		};
	};
	
	fragment@9 {
		target = <&rkisp_mmu>;

		__overlay__ {
			status = "okay";
		};
	};

/*  camera0_imx219 */
	fragment@10 {
		target = <&rkcif_mipi_lvds1>;

		__overlay__ {
			status = "okay";
			port {
				cif_mipi_in1: endpoint {
					remote-endpoint = <&mipi1_csi2_output>;
				};
			};
		};
	};
	
	fragment@11 {
		target = <&rkcif_mipi_lvds1_sditf>;

		__overlay__ {
			status = "okay";
			port {
				mipi1_lvds_sditf: endpoint {
					remote-endpoint = <&isp_vir0>;   
				};
			};
		};
	};
	
	fragment@12 {
		target = <&rkisp_vir0>;

		__overlay__ {
			status = "okay";
			port {
				#address-cells = <1>;
				#size-cells = <0>;

				isp_vir0: endpoint@0 {   
					reg = <0>;
					remote-endpoint = <&mipi1_lvds_sditf>;
				};
			};
		};
	};
};