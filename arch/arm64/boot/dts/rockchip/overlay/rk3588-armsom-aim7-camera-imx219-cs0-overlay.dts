/dts-v1/;
/plugin/;

#include <dt-bindings/clock/rk3588-cru.h>
#include <dt-bindings/power/rk3588-power.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>

/*
 * AIM7 CS0 (J13), IMX219 on i2c2.
 * csi2_dphy1 -> mipi2_csi2 -> rkcif_mipi_lvds2 -> rkisp0_vir2.
 * Load independently or together with the other AIM7 per-connector overlays.
 */

/ {
	fragment@0 {
		target-path = "/";
		__overlay__ {
			/* Module enable: use the same regulator method as AIM5. */
			vcc_cam0_pwdn: vcc-cam0-pwdn {
				compatible = "regulator-fixed";
				regulator-name = "vcc_cam0_pwdn";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
				regulator-boot-on;
				regulator-always-on;
				enable-active-high;
				vin-supply = <&vcc_1v8_s3>;
				gpio = <&gpio3 RK_PA2 GPIO_ACTIVE_HIGH>;
			};
		};
	};

	fragment@1 {
		target = <&i2c2>;
		__overlay__ {
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <&i2c2m0_xfer>;
			#address-cells = <1>;
			#size-cells = <0>;
			camera_imx219: camera-imx219@10 {
				status = "okay";
				compatible = "sony,imx219";
				reg = <0x10>;
				clocks = <&cru CLK_MIPI_CAMARAOUT_M0>;
				clock-names = "xvclk";
				pinctrl-names = "rockchip,camera_default";
				pinctrl-0 = <&mipim1_camera0_clk>;//gpio3_a5

				power-domains = <&power RK3588_PD_VI>;
				avdd-supply = <&vcc_cam0_pwdn>;

				rockchip,camera-module-index = <0>;
				rockchip,camera-module-facing = "back";
				rockchip,camera-module-name = "RADXA-CAMERA-8M";
				rockchip,camera-module-lens-name = "default";

				port {
					imx219_out0: endpoint {
						remote-endpoint = <&mipidphy0_in_ucam1>;
						data-lanes = <1 2>;
						clock-noncontinuous;
						link-frequencies = /bits/ 64 <456000000>;
					};
				};
			};
		};
	};

	fragment@2 {
		target = <&csi2_dphy0_hw>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@3 {
		target = <&csi2_dphy1_hw>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@4 {
		target = <&csi2_dphy1>;

		__overlay__ {
			status = "okay";
			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;

					mipidphy0_in_ucam1: endpoint@1 {
						reg = <1>;
						remote-endpoint = <&imx219_out0>;
						data-lanes = <1 2>;
					};
				};

				port@1 {
					reg = <1>;
					#address-cells = <1>;
					#size-cells = <0>;

					csidphy1_out: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&mipi2_csi2_input>;
					};
				};
			};
		};
	};

	fragment@5 {
		target = <&mipi2_csi2>;

		__overlay__ {
			status = "okay";
			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;

					mipi2_csi2_input: endpoint@1 {
						reg = <1>;
						remote-endpoint = <&csidphy1_out>;
					};
				};

				port@1 {
					reg = <1>;
					#address-cells = <1>;
					#size-cells = <0>;

					mipi2_csi2_output: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&cif_mipi_in2>;
					};
				};
			};
		};
	};

	fragment@6 {
		target = <&rkcif>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@7 {
		target = <&rkcif_mipi_lvds2>;

		__overlay__ {
			status = "okay";
			port {
				cif_mipi_in2: endpoint {
					remote-endpoint = <&mipi2_csi2_output>;
				};
			};
		};
	};

	fragment@8 {
		target = <&rkcif_mipi_lvds2_sditf>;

		__overlay__ {
			status = "okay";
			port {
				mipi2_lvds_sditf: endpoint {
					remote-endpoint = <&isp0_vir2>;
				};
			};
		};
	};

	fragment@9{
		target = <&rkcif_mmu>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@10{
		target = <&rkisp0>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@11{
		target = <&isp0_mmu>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@12{
		target = <&rkisp0_vir2>;

		__overlay__ {
			status = "okay";
			port {
				#address-cells = <1>;
				#size-cells = <0>;

				isp0_vir2: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&mipi2_lvds_sditf>;
				};
			};
		};
	};
};
