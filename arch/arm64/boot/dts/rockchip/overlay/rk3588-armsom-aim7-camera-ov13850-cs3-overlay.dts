/dts-v1/;
/plugin/;

#include <dt-bindings/clock/rk3588-cru.h>
#include <dt-bindings/power/rk3588-power.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>

/*
 * AIM7 CS3 (J24), OV13850 on i2c6.
 * csi2_dcphy0 -> mipi0_csi2 -> rkcif_mipi_lvds -> rkisp0_vir0.
 * Load independently or together with the other AIM7 per-connector overlays.
 */

/ {
	fragment@0 {
		target = <&i2c6>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <&i2c6m1_xfer>;
			ov13850_1: ov13850_1@10 {
				status = "okay";
				compatible = "ovti,ov13850";
				reg = <0x10>;
				clocks = <&cru CLK_MIPI_CAMARAOUT_M4>;
				clock-names = "xvclk";
				pinctrl-names = "rockchip,camera_default";
				pinctrl-0 = <&mipim1_camera4_clk>; /* GPIO3_B1 */
				pwdn-gpios = <&gpio3 RK_PB4 GPIO_ACTIVE_HIGH>;
				reset-gpios = <&gpio1 RK_PD7 GPIO_ACTIVE_HIGH>;
				rockchip,camera-module-index = <2>;
				rockchip,camera-module-facing = "back";
				rockchip,camera-module-name = "ZC-OV13850R2A-V1";
				rockchip,camera-module-lens-name = "Largan-50064B31";
				port {
					ov13850_out: endpoint {
						remote-endpoint = <&mipi_in_dcphy0>;
						data-lanes = <1 2 3 4>;
					};
				};
			};
		};
	};

	fragment@1 {
		target = <&csi2_dphy0_hw>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@2 {
		target = <&csi2_dphy1_hw>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@3 {
		target = <&mipi_dcphy0>;

		__overlay__ {
			status = "okay";

		};
	};

	fragment@4 {
		target = <&csi2_dcphy0>;

		__overlay__ {
			status = "okay";
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;

					mipi_in_dcphy0: endpoint@1 {
						reg = <1>;
						remote-endpoint = <&ov13850_out>;
						data-lanes = <1 2 3 4>;
					};
				};
				port@1 {
					reg = <1>;
					#address-cells = <1>;
					#size-cells = <0>;

					csidcphy0_out: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&mipi1_csi2_input>;
					};
				};
			};
		};
	};

	fragment@5 {
		target = <&mipi0_csi2>;

		__overlay__ {
			status = "okay";
			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;

					mipi1_csi2_input: endpoint@1 {
						reg = <1>;
						remote-endpoint = <&csidcphy0_out>;
					};
				};

				port@1 {
					reg = <1>;
					#address-cells = <1>;
					#size-cells = <0>;

					mipi0_csi2_output: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&cif_mipi_in0>;
					};
				};
			};
		};
	};

	fragment@6 {
		target = <&rkcif>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@7 {
		target = <&rkcif_mipi_lvds>;

		__overlay__ {
			status = "okay";
			port {
				cif_mipi_in0: endpoint {
					remote-endpoint = <&mipi0_csi2_output>;
				};
			};
		};
	};

	fragment@8 {
		target = <&rkcif_mipi_lvds_sditf>;

		__overlay__ {
			status = "okay";
			port {
				mipi_lvds_sditf: endpoint {
					remote-endpoint = <&isp0_vir0>;
				};
			};
		};
	};

	fragment@9{
		target = <&rkcif_mmu>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@10{
		target = <&rkisp0>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@11{
		target = <&isp0_mmu>;

		__overlay__ {
			status = "okay";
		};
	};

	fragment@12{
		target = <&rkisp0_vir0>;

		__overlay__ {
			status = "okay";
			port {
				#address-cells = <1>;
				#size-cells = <0>;

				isp0_vir0: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&mipi_lvds_sditf>;
				};
			};
		};
	};
};
